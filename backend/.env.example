# Copy this file to ".env" (same folder) and fill in the values. NEVER share or commit ".env".

# ---- Business (used in emails/SMS) ----
BUSINESS_NAME=Pittsburgh Auto
BUSINESS_ADDRESS=273 Moon Clinton Rd, Moon Township, PA 15108
BUSINESS_PHONE=(724) 780-0707
# The auto service itself gets an email + SMS for every new booking and every received payment
# ("PAYMENT RECEIVED $89.00 for BK-00002 - please check the card").
OWNER_EMAIL=
OWNER_PHONE=
# true = also notify when a booking is made (before payment); false = only when payment is received
OWNER_NOTIFY_ON_BOOKING=true

# ---- URLs ----
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# ---- Payments: mock (test page, no money) | stripe (real cards) | off (no payment step) ----
PAYMENT_MODE=mock
PAYMENT_HOLD_MINUTES=30
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (SMTP). Gmail: smtp.gmail.com / 587 / starttls / an "App password". Leave SMTP_HOST empty = test mode ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- SMS (Twilio). Leave empty = test mode (messages saved to backend/outbox/) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
